# ============================================================
# Environment Variables Template
# ============================================================
# Copy this file to ".env" (same folder) and fill in real values.
# The actual ".env" file is gitignored and should NEVER be
# committed — it will contain real credentials and secrets.
# ============================================================

# --- Server ---
PORT=5000

# --- PostgreSQL Database Connection ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=dunder_mifflin_wms
DB_USER=postgres
DB_PASSWORD=your_local_postgres_password

# --- Authentication ---
# Use a long, random string in your real .env (not this placeholder).
JWT_SECRET=replace_this_with_a_long_random_secret_string
JWT_EXPIRES_IN=8h